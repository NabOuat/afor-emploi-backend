# Configuration des bases de données pour la migration
# Remplacez ces valeurs par vos informations de connexion

# Base de données source (votre base actuelle)
SOURCE_DATABASE_URL=postgresql://username:password@localhost:5432/afor_emploi

# Base de données destination (Supabase)
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
